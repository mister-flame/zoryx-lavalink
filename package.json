  "description": "A small french discord bot written in JS with NodeJS that can create temporary channels and more importantly, which can play songs in voice channels.",
  "keywords": [
    "nodejs",
    "javascript",
    "bot",
    "discord",
    "youtube",
    "js",
    "french",
    "lavalink"
  ],
  "homepage": "https://github.com/mister-flame/zoryx-lavalink",
  "bugs": {
    "url": "https://github.com/mister-flame/zoryx-lavalink/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mister-flame/zoryx-lavalink.git"
  },
  "license": "ISC",
  "author": "MR.Flame",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node ."
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "axios": "^1.20.0",
    "discord.js": "^14.22.1",
    "lavalink-client": "^2.11.0",
    "ms": "^2.1.3",
    "phin": "^4.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "esbuild@0.28.2": true
  }
